# 이 파일은 템플릿. 새 환경에서 `npm run setup` 실행 시 .env.local 로 자동 복사됩니다.
# 빈 값들을 채우고 dev 서버를 실행하세요.

# ─── Prisma SQLite ───────────────────────────────────────────────
# prisma/schema.prisma 의 datasource db.url 가 참조. 그대로 두면 됨.
DATABASE_URL=file:./dev.db

# ─── OpenAI ──────────────────────────────────────────────────────
# 견적 파싱 / 임베딩 매칭 / AI 코멘트 / 챗봇 — 모두 동일 키 사용.
# https://platform.openai.com/api-keys 에서 발급.
OPENAI_API_KEY=

# ─── 스크래퍼 자격증명 ────────────────────────────────────────────
# 자동/수동 스크래핑이 각 사이트에 로그인할 때 사용. 없으면 해당 사이트 스킵.
# KPI = 한국물가정보, KPRC = 한국물가협회, CMPI = 대한건설협회.
KPI_ID=
KPI_PW=
KPRC_ID=
KPRC_PW=
CMPI_ID=
CMPI_PW=

# ─── Scheduler ───────────────────────────────────────────────────
# true 면 서버 부팅 시 cron 자동 등록 (src/instrumentation.ts).
# 개발 중엔 false 가 안전. UI 의 토글로 언제든 켤 수 있음.
SCHEDULER_ENABLED=false
